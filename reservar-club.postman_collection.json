            "body": {
              "mode": "raw",
              "raw": "{\n  \"court_id\": \"{{court_id}}\",\n  \"start_date\": \"2024-12-20T10:00:00Z\",\n  \"end_date\": \"2024-12-20T12:00:00Z\"\n}"
